<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <app.orchard.tv.parent.ScanFrameView
        android:id="@+id/scanFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/torchButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_scanner_chip"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="@string/scan_torch"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:buttonTint="@color/white" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/ParentSecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_scanner_chip"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/repair_cancel"
            android:textColor="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scanner_chip"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:text="@string/scan_prompt"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/zoomControls"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_scanner_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/scan_zoom_default"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/zoomBar"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:contentDescription="@string/scan_zoom"
                android:max="100"
                android:progressBackgroundTint="#66FFFFFF"
                android:progressTint="@color/white"
                android:thumbTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
