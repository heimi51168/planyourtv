<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlanYourTV.Parent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/page_top</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <!-- Every shell dialog uses the rounded card instead of the stock
             square AppCompat panel. -->
        <item name="alertDialogTheme">@style/Theme.PlanYourTV.Parent.Dialog</item>
        <item name="actionOverflowMenuStyle">@style/ParentPopupMenu</item>
    </style>

    <style name="ParentPopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="overlapAnchor">false</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
    </style>

    <style name="Theme.PlanYourTV.Parent.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowTitleStyle">@style/ParentDialogTitle</item>
        <item name="dialogPreferredPadding">24dp</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorControlHighlight">@color/brand_ripple</item>
        <item name="buttonBarPositiveButtonStyle">@style/ParentDialogActionPrimary</item>
        <item name="buttonBarNegativeButtonStyle">@style/ParentDialogActionSecondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/ParentDialogActionSecondary</item>
    </style>

    <style name="ParentDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="ParentDialogAction" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_dialog_action</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ParentDialogActionPrimary" parent="ParentDialogAction">
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="ParentDialogActionSecondary" parent="ParentDialogAction">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="ParentPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ParentSecondaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
