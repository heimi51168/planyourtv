<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlanYourTV.Parent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>

    <style name="ParentPrimaryButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ParentSecondaryButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/brand</item>
    </style>
</resources>
